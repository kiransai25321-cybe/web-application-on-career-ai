# AI Resume Analyzer Environment Configuration Example
# Copy this file to .env and configure your variables

# Required: Flask / Starlette Session Secret Key
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production

# Database URL (Defaults to SQLite in the workspace)
DATABASE_URL=sqlite:///./resume_analyzer.db

# Optional: Google OAuth 2.0 Credentials (Authlib)
# If empty or missing, Google Sign-In is automatically hidden in the UI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: LLM API Key (e.g., Google Gemini or OpenAI)
# If not provided, the application uses an intelligent rule-based feedback synthesizer
LLM_API_KEY=
